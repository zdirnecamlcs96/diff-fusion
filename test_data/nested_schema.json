{
    "cif_schema": {
        "product_name": {
            "type": "string",
            "required": true
        },
        "price": {
            "type": "number",
            "required": true
        },
        "currency": {
            "type": "string",
            "required": true
        },
        "in_stock": {
            "type": "boolean",
            "required": true
        },
        "quantity": {
            "type": "number",
            "required": true
        }
    },
    "transformations": {
        "nested_format": {
            "product_name": {
                "source_path": "item",
                "type": "string"
            },
            "price": {
                "source_path": "pricing.amount",
                "type": "number"
            },
            "currency": {
                "source_path": "pricing.currency",
                "type": "string"
            },
            "in_stock": {
                "source_path": "stock.available",
                "type": "boolean"
            },
            "quantity": {
                "source_path": "stock.quantity",
                "type": "number"
            }
        },
        "flat_format": {
            "product_name": {
                "source_path": "productName",
                "type": "string"
            },
            "price": {
                "source_path": "cost",
                "type": "number"
            },
            "currency": {
                "source_path": "currencyCode",
                "type": "string"
            },
            "in_stock": {
                "source_path": "inStock",
                "type": "boolean"
            },
            "quantity": {
                "source_path": "qty",
                "type": "number"
            }
        }
    }
}